# Docker Compose passwords must be URL-safe because they are embedded in
# internal connection URLs. Never reuse these placeholders.
POSTGRES_PASSWORD=replace-with-url-safe-postgres-password
REDIS_PASSWORD=replace-with-url-safe-redis-password

# PostgreSQL used by the backend. Compose supplies its own internal URL; this
# localhost value is for a locally started application process.
DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@localhost:5432/ecommerce

# Versioned API Gateway. Format: principal:secret[,principal:secret].
# Replace the local demo credential before any shared or production deployment.
APP_ENV=development
GATEWAY_API_KEYS=demo:demo-local-key
OPERATIONS_API_KEY=
GATEWAY_RATE_LIMIT_REQUESTS=30
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_AUTH_ATTEMPT_REQUESTS=120
SESSION_TTL_SECONDS=3600
SHARED_STATE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=ecommerce_agents
REDIS_SOCKET_TIMEOUT_SECONDS=2
KNOWLEDGE_BACKEND=static
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=sample_market_knowledge
QDRANT_TIMEOUT_SECONDS=3
ORCHESTRATION_TIMEOUT_SECONDS=30
LEGACY_CHAT_ENABLED=true

# OpenAI API key for real model calls. Leave blank to run database/tools/tests
# without calling the external model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
MODEL_RUNTIME_MODE=hybrid
OPENAI_ROUTING_MODEL=gpt-5.4-nano
OPENAI_PLANNING_MODEL=gpt-5.4-mini
OPENAI_SPECIALIST_MODEL=gpt-5.4-nano
OPENAI_SYNTHESIS_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT_SECONDS=18
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_CONCURRENCY=8
OPENAI_CIRCUIT_FAILURE_THRESHOLD=4
OPENAI_CIRCUIT_RECOVERY_SECONDS=30

# `auto` uses OpenAI when OPENAI_API_KEY exists, otherwise the deterministic
# hashing embedder. OpenAI-backed vectors use a separate `_openai_v1` Qdrant
# collection so incompatible vector spaces are never mixed.
EMBEDDING_BACKEND=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
LOG_LEVEL=INFO
