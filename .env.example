# PostgreSQL used by the backend. The Docker Compose value points at the
# postgres service automatically; this localhost value is for local uvicorn.
DATABASE_URL=postgresql+psycopg://ecommerce:ecommerce@localhost:5432/ecommerce

# Gemini API key for real ADK calls. Leave blank to run database/tools/tests
# without calling the external model.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
# Newer ADK releases use this name; the app sets both for compatibility.
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

ADK_MODEL=gemini-2.5-flash
ADK_APP_NAME=vietnamese_ecommerce_phase1
LOG_LEVEL=INFO
