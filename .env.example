# PostgreSQL used by the backend. This value matches the disposable local
# database started by `docker compose up -d` (see compose.yaml).
DATABASE_URL=postgresql+psycopg://ecommerce_p1:p1-local-disposable-only@127.0.0.1:55432/ecommerce_p1

# Versioned API Gateway. Format: principal:secret[,principal:secret].
# Replace the local demo credential before any shared or production deployment.
# Every production secret after `principal:` must contain at least 16 characters.
APP_ENV=development
GATEWAY_API_KEYS=demo:demo-local-key
# Trusted principal policy. Format: principal:tenant:scope1|scope2.
GATEWAY_PRINCIPAL_POLICIES=demo:default:ecommerce.read
OPERATIONS_API_KEY=
GATEWAY_RATE_LIMIT_REQUESTS=30
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_AUTH_ATTEMPT_REQUESTS=120
SESSION_TTL_SECONDS=3600
SHARED_STATE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=ecommerce_agents
REDIS_SOCKET_TIMEOUT_SECONDS=2
KNOWLEDGE_BACKEND=disabled
# Optional Qdrant adapter settings. They are ignored while knowledge is disabled.
# No knowledge documents are bundled or seeded by this repository.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge
QDRANT_TIMEOUT_SECONDS=3
ORCHESTRATION_TIMEOUT_SECONDS=30
LEGACY_CHAT_ENABLED=true

# OpenAI API key for the v1 multi-agent model runtime and optional embeddings.
# Leave blank only when MODEL_RUNTIME_MODE=off (or for offline tests). Production
# refuses to start with an enabled model runtime and no provider key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# off: deterministic only; shadow: call GPT but keep deterministic decisions;
# hybrid: use valid grounded GPT results with deterministic fallback;
# required: fail closed when a model call or authorization check fails.
MODEL_RUNTIME_MODE=hybrid
OPENAI_ROUTING_MODEL=gpt-5.4-nano
OPENAI_PLANNING_MODEL=gpt-5.4-mini
OPENAI_SPECIALIST_MODEL=gpt-5.4-nano
OPENAI_SYNTHESIS_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT_SECONDS=18
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_CONCURRENCY=8
OPENAI_CIRCUIT_FAILURE_THRESHOLD=4
OPENAI_CIRCUIT_RECOVERY_SECONDS=30

# `auto` uses OpenAI when OPENAI_API_KEY exists, otherwise the deterministic
# hashing embedder. Production Qdrant + `auto` requires a key. To deploy without
# any external model, set MODEL_RUNTIME_MODE=off and EMBEDDING_BACKEND=hashing.
# OpenAI-backed vectors use a separate `_openai_v1` Qdrant collection so
# incompatible vector spaces are never mixed.
EMBEDDING_BACKEND=auto
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
LOG_LEVEL=INFO
